# =============================================================
# Personal Knowledge Agent - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored - never commit API keys.
# NOTE: Keep this file ASCII-only (Windows reads .env with GBK).

# ----- Obsidian Vault Path -----
OBSIDIAN_VAULT_PATH=E:/agent-projects/obsidian-vault

# ----- LLM Configuration -----
# chat via SiliconFlow (OpenAI-compatible), embedding via SiliconFlow BAAI/bge-m3
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# ----- Qdrant Storage -----
QDRANT_PATH=./qdrant_data_v2

# ----- Embedding Model -----
EMBEDDING_MODEL=BAAI/bge-m3

# ----- LangSmith (Observability) -----
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=personal-knowledge-agent

# ----- Model Defaults -----
DEFAULT_MODEL_KEY=deepseek-v4
GUARDRAILS_MODEL_KEY=qwen3-8b

# ----- Prompt Configuration -----
USE_LOCAL_PROMPTS=true

# ----- CORS -----
# 前端端口: dev=3000, dev:remote=3001 —— 两者都需放行
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
ALLOWED_ORIGINS=https://smith.langchain.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# LangGraph API server CORS (server.py 优先读它)
CORS_ALLOW_ORIGINS=https://smith.langchain.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
NEXT_PUBLIC_LANGGRAPH_API_URL=http://127.0.0.1:3001

# ----- Optional: Other LLM Providers -----
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GOOGLE_API_KEY=your_google_api_key_here
